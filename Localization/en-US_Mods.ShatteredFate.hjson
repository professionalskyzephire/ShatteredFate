Items: {
	CosmicDust: {
		DisplayName: Cosmic Dust
		Tooltip: A tangible mass of cosmic dust. Has some arcane properties.
	}

	AncientSkull: {
		DisplayName: Ancient Skull
		Tooltip: 
			'''
			Summons ancient skulls that furiously ram into nearby enemies, exploding violently on contact.
			Does not occupy minion slots.
			'''
	}

	OldCrossbow: {
		DisplayName: Old Crossbow
		Tooltip:
			'''
			<left> to fire a singular bolt that attaches to enemies or the ground
			Hold <right> to load five, powerful golden bolts
			Golden bolts pierce five times and increases money drops from enemies
			'''
	}

	OldFrypan: {
		DisplayName: Old Frypan
		Tooltip:
			'''
			Charge up the strike.
			Fully charged blows can reflect projectiles. Cooldown 5 seconds.
			Critical hits deal 200%-450% of the weapon's damage.
			'It can no longer be used for cooking, but at least it's still good for smashing the heads of your enemies.'
			'''
	}

	Starstaff: {
		DisplayName: Starstaff
		Tooltip:
			'''
			<left> to create a shower of 2-3 stars on your cursor location
			<right> to summon 3 controllable stars that follow your cursor
			'''
	}

	SandSpell: {
		DisplayName: Sand Spell
		Tooltip: Creates a localized sandstorm that pulls enemies and dropped items into itself.
	}

	MagnetismPotion: {
		DisplayName: Magnetism Potion
		Tooltip:
			'''
			Temporarily greatly increases the player's item grab range.
			'Drinking too many of these at a time might have unexpected results...'  
			'''
	}

	AntidotePotion: {
		DisplayName: Antidote
		Tooltip: Grants temporary immunity to poison.
	}

	PackOExplosives: {
		DisplayName: Pack-o'-Explosives
		Tooltip:
			'''
			Makes the player explode on hit.
			'Looks rather peaceful, eh?'
			'''
	}

	WreckingBall: {
		DisplayName: Wrecking Ball
		Tooltip: Can break tiles when launched. Can break tiles mineable with pickaxes up to Gold/Platinum.
	}

	AntiqueDagger: {
		DisplayName: Antique Dagger
		Tooltip: ""
	}

	FusedGemstone: {
		DisplayName: Fused Gemstone
		Tooltip: ""
	}

	CuriousCandle: {
		DisplayName: Curious Candle
		Tooltip:
			'''
			Spawns homing fireballs when held.
			If there are no enemies nearby, the fireballs will stack behind your back.
			'''
	}

	SanguineLeech: {
		DisplayName: Sanguine Leech
		Tooltip: 
		'''
		5 summon tag damage
		Your minions will focus struck enemies
		Latches onto a hit enemy, slows it down and steals its life.
		The less health the player has, the more life the whip will steal.
		'''
	}
}

